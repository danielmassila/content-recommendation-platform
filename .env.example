# Copy to .env if you want to override default config
POSTGRES_DB=reco_db
POSTGRES_USER=reco_user
POSTGRES_PASSWORD=reco_pass

# Frontend origins allowed by the Spring API
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local auth settings for the Spring API
APP_JWT_SECRET=change-this-local-development-secret
APP_JWT_EXPIRATION_SECONDS=86400

# Optional: used by `make py-enrich-tmdb`
TMDB_API_KEY=
TMDB_ENRICH_LIMIT=100
TMDB_REQUEST_DELAY_SECONDS=0.25
